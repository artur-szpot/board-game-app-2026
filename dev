#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

if ! docker compose -f compose.watch.yaml up --build "$@"; then
	cat <<'EOF'

Compose startup failed.

If this happened right after DB initialization, the cycle-trigger integration gate may have failed.
Inspect it with:
	docker compose -f compose.watch.yaml logs db-cycle-tests

If needed, rerun only that gate:
	docker compose -f compose.watch.yaml run --rm db-cycle-tests

EOF
	exit 1
fi